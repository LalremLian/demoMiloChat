# ============================================================
# MiloChat Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/milochat
# For MongoDB Atlas use:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/milochat

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_different_64_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Agora ────────────────────────────────────────────────────
# App ID is public — safe to use in the app
AGORA_APP_ID=your_agora_app_id
# App Certificate is SECRET — stays on the server only, never in the mobile app
AGORA_APP_CERTIFICATE=your_agora_app_certificate
# How long Agora tokens last (seconds). 3600 = 1 hour
AGORA_TOKEN_EXPIRY=3600

# ── Firebase (for FCM push notifications) ────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
